#!/usr/bin/ucode
/*
 * Terminal session API. Auth required on every operation.
 * Ops: join | read | write | leave | takeover | ping | stop | neighbors
 * Clients: cid identifies browser; one primary may write, viewers are readonly.
 */

import * as term from "aredn_terminal";

const env = {
    HTTP_COOKIE: getenv("HTTP_COOKIE") || "",
    REQUEST_METHOD: getenv("REQUEST_METHOD") || "GET",
    QUERY_STRING: getenv("QUERY_STRING") || "",
};

function jsonValue(v)
{
    const t = type(v);
    if (t == "bool") {
        print(v ? "true" : "false");
    }
    else if (t == "int" || t == "double") {
        print(`${v}`);
    }
    else if (v == null) {
        print("null");
    }
    else if (t == "array") {
        print("[");
        for (let i = 0; i < length(v); i++) {
            if (i > 0) {
                print(",");
            }
            jsonValue(v[i]);
        }
        print("]");
    }
    else if (t == "object") {
        print("{");
        let first = true;
        for (let k in v) {
            if (!first) {
                print(",");
            }
            first = false;
            print(`"${term.jsonEscape(`${k}`)}":`);
            jsonValue(v[k]);
        }
        print("}");
    }
    else {
        print(`"${term.jsonEscape(`${v}`)}"`);
    }
}

function send(code, obj)
{
    const status = code == 200 ? "200 OK" :
        code == 401 ? "401 Unauthorized" :
        code == 400 ? "400 Bad Request" :
        code == 403 ? "403 Forbidden" :
        code == 409 ? "409 Conflict" :
        code == 410 ? "410 Gone" : `${code}`;
    print(`Status: ${status}\r\n`);
    print("Content-type: application/json; charset=utf-8\r\n");
    print("Cache-Control: no-store\r\n");
    print("\r\n");
    jsonValue(obj);
    print("\n");
}

function bodyParam(body, name)
{
    const re = regexp(`(^|&)${name}=([^&]*)`);
    const m = match(body, re);
    if (m) {
        return term.urlDecode(m[2]);
    }
    return null;
}

if (!term.isAuthenticated(env)) {
    send(401, { error: "unauthorized" });
}
else {
    const q = term.parseQuery(env.QUERY_STRING);
    let op = q.op || "";
    // Prefer cid; accept legacy sid as client id for leave/stop from old UIs.
    const cid = q.cid || q.sid || "";
    let body = "";
    let target = q.target || "";

    if (env.REQUEST_METHOD == "POST") {
        body = term.readPostBody();
        if (!op) {
            const fromBody = bodyParam(body, "op");
            if (fromBody != null) {
                op = fromBody;
            }
        }
        if (!target) {
            const fromBody = bodyParam(body, "target");
            if (fromBody != null) {
                target = fromBody;
            }
        }
    }

    term.cleanupStale();

    if (op == "neighbors") {
        send(200, term.neighborsPayload());
    }
    else if (op == "join" || op == "start") {
        const r = term.joinSession(target || "local");
        if (r.error) {
            send(400, r);
        }
        else {
            send(200, { ok: true, sid: r.sid, cid: r.cid, role: r.role, target: r.target });
        }
    }
    else if (op == "read") {
        const r = term.readSession(cid);
        if (r.error == "gone") {
            send(410, r);
        }
        else if (r.error) {
            send(400, r);
        }
        else {
            send(200, {
                ok: true,
                data: b64enc(r.data),
                offset: r.offset,
                alive: true,
                role: r.role,
                cid: r.cid,
                sid: r.sid
            });
        }
    }
    else if (op == "write") {
        let data = "";
        if (q.data != null && q.data !== "") {
            data = b64dec(term.urlDecode(q.data)) || "";
        }
        else {
            const fromBody = bodyParam(body, "data");
            if (fromBody != null) {
                data = b64dec(fromBody) || "";
            }
            else if (length(body)) {
                data = body;
            }
        }
        const r = term.writeSession(cid, data);
        if (r.error == "gone") {
            send(410, r);
        }
        else if (r.error == "readonly") {
            send(403, r);
        }
        else if (r.error) {
            send(400, r);
        }
        else {
            send(200, { ok: true, role: "primary" });
        }
    }
    else if (op == "takeover") {
        const r = term.takeover(cid);
        if (r.error == "gone") {
            send(410, r);
        }
        else if (r.error) {
            send(400, r);
        }
        else {
            send(200, { ok: true, role: r.role, cid: r.cid, sid: r.sid });
        }
    }
    else if (op == "leave" || op == "stop") {
        if (cid) {
            const r = term.leaveClient(cid);
            send(200, { ok: true, closed: r.closed ? true : false });
        }
        else {
            term.stopAll();
            send(200, { ok: true, closed: true });
        }
    }
    else if (op == "ping") {
        const r = term.pingClient(cid);
        if (r.error == "gone") {
            send(410, r);
        }
        else if (r.error) {
            send(400, r);
        }
        else {
            send(200, { ok: true, role: r.role, cid: r.cid });
        }
    }
    else {
        send(400, { error: "bad_op", message: "op must be join|read|write|leave|takeover|ping|stop|neighbors" });
    }
}
